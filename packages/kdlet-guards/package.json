{
  "name": "kdlet-guards",
  "version": "0.3.1",
  "description": "A small condition language as plain data: named conditions, is, has, not, all and any, before, after, less and more, host guards and registered words, with a reader and writer for KDL",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kdl": {
      "types": "./dist/kdl.d.ts",
      "import": "./dist/kdl.js"
    }
  },
  "scripts": {
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "build": "tsup src/index.ts src/kdl.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@bgotink/kdl": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@bgotink/kdl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bgotink/kdl": "^0.4.0"
  },
  "keywords": [
    "kdl",
    "kdlet",
    "guard",
    "condition",
    "rules"
  ],
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/egildo/kdlet.git",
    "directory": "packages/kdlet-guards"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://codeberg.org/egildo/kdlet",
  "bugs": {
    "url": "https://codeberg.org/egildo/kdlet/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
